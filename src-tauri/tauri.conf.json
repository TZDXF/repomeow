{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoMeow",
  "version": "0.2.13",
  "identifier": "com.repomeow.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RepoMeow",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": [
            "**/.repomeow/**",
            "**/.ssh/**",
            "**/.aws/**",
            "**/.gnupg/**",
            "**/.config/gcloud/**",
            "**/.azure/**",
            "**/.kube/**",
            "**/.docker/**",
            "**/.env",
            "**/.env.*",
            "**/.npmrc",
            "**/.netrc",
            "**/.git-credentials",
            "**/.htpasswd",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/*.pfx",
            "**/*.kdbx",
            "**/id_rsa*",
            "**/id_dsa*",
            "**/id_ed25519*",
            "**/id_ecdsa*",
            "**/credentials.json"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": [
      "binaries/sem"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "i18n/tray/*.json",
      "third-party/sem/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMjIxNEJGMDg3Qzk4NDMKUldSRG1Id0l2eFFpTWdWcDlEWG93QlpOclJibmF6NExEbVdoZGZueFd6VlR2RWo3YlpBU1Jua3AK",
      "endpoints": [
        "https://github.com/TZDXF/repomeow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
